// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ui_font_weight": 600.0,
  "instrumentation": {
    "performance_profiler": {
      "enabled": true
    }
  },
  "diff_view_style": "unified",
  "calls": {
    "mute_on_join": true
  },
  "buffer_font_weight": 400.0,
  "languages": {
    "Git Commit": {
      "soft_wrap": "none"
    },
    "Python": {
      "language_servers": ["ruff", "basedpyright"],
      "format_on_save": "on",
      "formatter": "language_server"
    }
  },
  "lsp": {
    "jdtls": {
      "settings": {
        "java_home": "C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.6.7-hotspot",
        "lombok_support": true
      }
    },
    "basedpyright": {
      "settings": {
        "python": {
          "pythonPath": ".venv\\Scripts\\python.exe"
        },
        "basedpyright": {
          "analysis": {
            "autoImportCompletions": true,
            "typeCheckingMode": "standard"
          }
        }
      }
    }
  },
  "preferred_line_length": 1000,
  "edit_predictions": {
    "provider": "open_ai_compatible_api",
    "open_ai_compatible_api": {
      "max_output_tokens": 100,
      "model": "nvidia/nemotron-3-super-120b-a12b:free",
      "api_url": "https://openrouter.ai"
    },
    "codestral": {
      "api_url": "https://codestral.mistral.ai",
      "model": "codestral-latest"
    }
  },
  "focus_follows_mouse": {
    "enabled": false
  },
  "use_system_window_tabs": false,
  "bottom_dock_layout": "right_aligned",
  "git": {
    "diff_base": "head",
    "inline_blame": {
      "show_commit_summary": false
    }
  },
  "outline_panel": {
    "button": true,
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "kilo": {
      "type": "registry"
    },
    "opencode": {
      "default_config_options": {
        "model": "opencode/deepseek-v4-flash-free"
      },
      "type": "registry"
    },
    "gemini": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "agent": {
    "default_profile": "ask",
    "button": true,
    "dock": "right",
    "default_model": {
      "provider": "opencode",
      "model": "free/minimax-m2.5-free",
      "enable_thinking": false
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "context_servers": {
    "Context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "YOUR_CONTEXT7_API_KEY"
      ]
    }
  },
  "git_panel": {
    "file_icons": false,
    "collapse_untracked_diff": false,
    "sort_by_path": false,
    "tree_view": true,
    "status_style": "icon",
    "dock": "right",
    "button": true
  },
  "title_bar": {
    "show_branch_status_icon": false
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false
  },
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "inlay_hints": {
    "enabled": false
  },
  "toolbar": {
    "code_actions": false
  },
  "which_key": {
    "enabled": false
  },
  "ui_font_family": "Google Sans Code",
  "buffer_font_family": "Google Sans Code",
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "terminal": {
    "dock": "bottom",
    "show_count_badge": true,
    "font_size": 13.0,
    "font_family": "Maple Mono NF"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "project_panel": {
    "button": true,
    "sort_mode": "directories_first",
    "hide_hidden": false,
    "hide_root": true,
    "diagnostic_badges": false,
    "bold_folder_labels": false,
    "folder_icons": true,
    "file_icons": true,
    "entry_spacing": "standard",
    "dock": "left",
    "git_status_indicator": true,
    "auto_fold_dirs": true
  },
  "preview_tabs": {
    "enable_preview_from_project_panel": true,
    "enable_keep_preview_on_code_navigation": false,
    "enable_preview_multibuffer_from_code_navigation": false,
    "enable_preview_from_file_finder": true,
    "enabled": false
  },
  "status_bar": {
    "show_active_file": false,
    "active_language_button": true,
    "experimental.show": true
  },
  "minimap": {
    "show": "auto"
  },
  "cursor_blink": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 2500
    }
  },
  "file_types": {},
  "auto_indent_on_paste": true,
  "linked_edits": true,
  "use_on_type_format": true,
  "indent_guides": {
    "enabled": true
  },
  "tab_size": 2,
  "base_keymap": "VSCode",
  "ui_font_size": 14.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "macOS Classic Light",
    "dark": "Catppuccin Mocha - No Italics"
  },
  "show_completions_on_input": true
}
