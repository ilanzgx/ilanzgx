{
  "editor.fontSize": 13,
  "editor.fontWeight": "400",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.fontSize": 13,
  "window.newWindowDimensions": "maximized",
  "terminal.integrated.fontWeight": "300",
  "editor.glyphMargin": true,
  "editor.fontFamily": "Comic Mono, Maple Mono, Inconsolata, Mononoki, Cascadia Code, Agave, Maple Mono NF, Iosevka Term, JetBrains Mono, Fira Code",
  "editor.fontLigatures": true,
  "scm.inputFontFamily": "JetBrains Mono",
  "chat.editor.fontFamily": "JetBrains Mono",
  "debug.console.fontFamily": "JetBrains Mono",
  "editor.codeLensFontFamily": "JetBrains Mono",
  "notebook.output.fontFamily": "JetBrains Mono",
  "markdown.preview.fontFamily": "JetBrains Mono",
  "terminal.integrated.fontFamily": "Maple Mono NF",
  "vscode_custom_css.policy": true,
  "workbench.settings.editor": "json",
  "apc.activityBar": {
    "size": 0
  },
  "explorer.confirmDragAndDrop": false,
  "editor.cursorSmoothCaretAnimation": "on",
  "workbench.startupEditor": "none",
  "explorer.compactFolders": true,
  "editor.tabSize": 2,
  "editor.linkedEditing": true,
  "breadcrumbs.icons": false,
  "breadcrumbs.symbolPath": "off",
  "files.trimTrailingWhitespace": true,
  "editor.bracketPairColorization.enabled": true,
  "workbench.activityBar.location": "default",
  "window.titleBarStyle": "native",
  "window.customTitleBarVisibility": "never",
  "editor.cursorBlinking": "phase",
  "explorer.confirmDelete": false,
  "files.autoSave": "afterDelay",
  "editor.formatOnType": true,
  "update.mode": "none",
  "editor.accessibilitySupport": "off",
  "editor.letterSpacing": 0.5,
  "editor.formatOnPaste": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.minimap.enabled": false,
  "tailwindCSS.colorDecorators": false,
  "editor.lineHeight": 2,
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleDeclarations": "goto",
  "editor.gotoLocation.multipleImplementations": "goto",
  "editor.gotoLocation.multipleReferences": "goto",
  "editor.gotoLocation.multipleTypeDefinitions": "goto",
  "editor.guides.bracketPairs": "active",
  "editor.guides.indentation": true,
  "window.commandCenter": false,
  "workbench.layoutControl.enabled": false,
  "editor.stickyScroll.enabled": false,
  "workbench.statusBar.visible": true,
  "workbench.tree.indent": 12,
  "workbench.editor.labelFormat": "short",
  "workbench.colorCustomizations": {
    "[Vesper]": {
      "tab.activeBorder": "#FFF",
      "tab.activeForeground": "#fff",
      "tab.activeBackground": "#101010",
      "tab.hoverBorder": "#ffffff",
      "tab.activeBorderTop": "#fff",
      "tab.inactiveForeground": "#C5C5C5",
      "tab.inactiveBackground": "#101010"
    }
  },
  "errorLens.scrollbarHackEnabled": true,
  "workbench.sideBar.location": "left",
  "editor.stickyScroll.scrollWithEditor": false,
  "workbench.tree.enableStickyScroll": false,
  "supermaven.enable": {
    "*": true
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma",
    "editor.formatOnSave": true
  },
  "git.autofetch": true,
  "workbench.editor.enablePreview": false,
  "codeium.enableCodeLens": false,
  "jestrunner.codeLensSelector": "**/*.{test,spec,int-spec}.{js,jsx,ts,tsx}",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "material-icon-theme.folders.associations": {},
  "material-icon-theme.files.customClones": [],
  "javascript.inlayHints.parameterTypes.enabled": false,
  "typescript.inlayHints.parameterNames.enabled": "all",
  "typescript.inlayHints.parameterTypes.enabled": false,
  "javascript.inlayHints.enumMemberValues.enabled": true,
  "javascript.inlayHints.functionLikeReturnTypes.enabled": false,
  "security.workspace.trust.untrustedFiles": "open",
  "[dotenv]": {
    "editor.formatOnSave": false
  },
  "workbench.editor.customLabels.patterns": {
    "**/app/**/page.tsx": "(${dirname})/page.${extname}",
    "**/app/**/_layout.tsx": "(${dirname})/_layout.${extname}",
    "**/app/**/index.tsx": "(${dirname})/index.${extname}"
  },
  "terminal.explorerKind": "external",
  "docker.extension.dockerEngineAvailabilityPrompt": false,
  "material-icon-theme.activeIconPack": "none",
  "workbench.iconTheme": "material-icon-theme",
  "diffEditor.codeLens": true,
  "svelte.enable-ts-plugin": true,
  "diffEditor.ignoreTrimWhitespace": false
}
